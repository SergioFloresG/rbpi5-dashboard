# Ubicación para clima, sol y luna
DASH_CIUDAD=Cancún
DASH_LAT=21.1619
DASH_LON=-86.8515
DASH_TZ=America/Cancun
DASH_PORT=3000
# 127.0.0.1 = solo la Pi; 0.0.0.0 = accesible desde la LAN (http://IP-de-la-Pi:3000)
DASH_HOST=127.0.0.1
# Segundos que se guardan los datos del clima antes de volver a pedirlos
DASH_CACHE_SEG=900
# Tema: AUTO (claro de amanecer a anochecer, oscuro de noche), BLACK u WHITE
DASH_TEMA=AUTO
# Zoom del mapa de radar (RainViewer da datos hasta 7; 6 muestra más región)
DASH_RADAR_ZOOM=7
# Batería EcoFlow Delta 3 / 3 Plus (misma cuenta que la app). Vacío = tarjeta oculta
ECOFLOW_EMAIL=
ECOFLOW_PASSWORD=
# Número de serie (app EcoFlow > dispositivo > Ajustes > Información)
ECOFLOW_SN=
# api.ecoflow.com (global/América) o api-e.ecoflow.com (Europa)
ECOFLOW_API_HOST=api.ecoflow.com
# Capacidad en Wh si la batería no la reporta (Delta 3 Plus = 1024)
ECOFLOW_CAPACIDAD_WH=1024
# Salida máxima en W si la batería no la reporta (Delta 3 Plus = 1800)
ECOFLOW_SALIDA_MAX_W=1800
# 1 = datos simulados, sin conectarse a EcoFlow
ECOFLOW_DEMO=0
# UPS por NUT, lista separada por comas de [Etiqueta=]ups[@host[:puerto]]. Vacío = tarjeta oculta
# Ej.: UPS_NUT=CP1500=cp1500@localhost   (./instalar_ups.sh lo configura)
UPS_NUT=
# Segundos entre lecturas del UPS
UPS_INTERVALO_SEG=5
# 1 = datos simulados, sin NUT
UPS_DEMO=0
# Purificadores Dyson por MQTT local: [Etiqueta=]serie|tipo|credencial[|host], separados por comas.
# Vacío = tarjeta oculta. `.venv/bin/python dyson_login.py` lo llena con la cuenta Dyson
DYSON_EQUIPOS=
# Segundos entre lecturas del purificador
DYSON_INTERVALO_SEG=30
# 1 = datos simulados, sin purificador
DYSON_DEMO=0
