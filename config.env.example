# Ubicación para clima, sol y luna
DASH_CIUDAD=Cancún
DASH_LAT=21.1619
DASH_LON=-86.8515
DASH_TZ=America/Cancun
DASH_PORT=3000
# 127.0.0.1 = solo la Pi; 0.0.0.0 = accesible desde la LAN (http://IP-de-la-Pi:3000)
DASH_HOST=127.0.0.1
# Segundos que se guardan los datos del clima antes de volver a pedirlos
DASH_CACHE_SEG=900
# Tema: AUTO (claro de amanecer a anochecer, oscuro de noche), BLACK u WHITE
DASH_TEMA=AUTO
# Zoom del mapa de radar (RainViewer da datos hasta 7; 6 muestra más región)
DASH_RADAR_ZOOM=7
# Batería EcoFlow Delta 3 / 3 Plus (misma cuenta que la app). Vacío = tarjeta oculta
ECOFLOW_EMAIL=
ECOFLOW_PASSWORD=
# Número de serie (app EcoFlow > dispositivo > Ajustes > Información)
ECOFLOW_SN=
# api.ecoflow.com (global/América) o api-e.ecoflow.com (Europa)
ECOFLOW_API_HOST=api.ecoflow.com
# Capacidad para calcular los Wh disponibles (Delta 3 Plus = 1024)
ECOFLOW_CAPACIDAD_WH=1024
# 1 = datos simulados, sin conectarse a EcoFlow
ECOFLOW_DEMO=0
